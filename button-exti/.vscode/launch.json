{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug button-exti (ST-LINK)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "stlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/button-exti.elf",
      "device": "STM32L476RG",
      "interface": "swd",
      "runToEntryPoint": "main",
      "svdFile": "/opt/st/stm32cubeclt_1.22.0/STMicroelectronics_CMSIS_SVD/STM32L476.svd",
      "preLaunchTask": "build button-exti"
    },
    {
      "name": "Attach button-exti (running board)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "stlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/button-exti.elf",
      "device": "STM32L476RG",
      "interface": "swd",
      "svdFile": "/opt/st/stm32cubeclt_1.22.0/STMicroelectronics_CMSIS_SVD/STM32L476.svd"
    }
  ]
}
